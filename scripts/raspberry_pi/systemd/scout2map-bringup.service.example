# Optional: start the real UGV stack (SLAM/Nav2/return_home/comm_relay,
# via s2m_return_home_real.launch.py) automatically on boot, so the robot
# comes up without anyone SSH-ing in and running `ros2 launch` by hand.
#
# This is opt-in - install.sh does NOT install or enable this. Motion is
# still safe by default: s2m_return_home_real.launch.py brings the ROS
# graph up but cmd_vel_safety_gate stays blocked until you explicitly call
# /return_home/capture_start and /return_home/arm (see the top-level
# README's "실차 자동 복귀와 안전 게이트" section) - booting the stack does
# not make the robot drive.
#
# Install:
#   sudo cp scout2map-bringup.service.example \
#     /etc/systemd/system/scout2map-bringup.service
#   sudo $EDITOR /etc/systemd/system/scout2map-bringup.service   # fix User=/HOME= below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now scout2map-bringup.service
#
# Watch it / stop it:
#   journalctl -u scout2map-bringup.service -f
#   sudo systemctl stop scout2map-bringup.service       # e.g. to run ros2 launch by hand instead

[Unit]
Description=Scout2Map real UGV bringup (SLAM/Nav2/return_home/comm_relay)
# Serial devices (LiDAR/MCUs) enumerate late on some Pi 5 + USB hub
# combinations; wait for basic multi-user boot rather than racing them.
After=multi-user.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# CHANGE ME: the account install.sh was run as (whoever's ~/scout2map_env.sh
# and ~/scout2map_ws exist).
User=pi
Environment=HOME=/home/pi
# udev symlinks (/dev/scout2map_*) can take a couple seconds to settle
# after the kernel finishes enumerating USB on boot.
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash -lc 'source "$HOME/scout2map_env.sh" && exec ros2 launch s2m_bringup s2m_return_home_real.launch.py'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
